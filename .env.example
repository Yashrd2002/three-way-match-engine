# Three-Way Match Engine - Root Environment Variables Example

# Backend Server Port
PORT=5001

# MongoDB Connection String (leave blank or default to use MongoMemoryServer automatically)
MONGODB_URI=mongodb://127.0.0.1:27017/three_way_match

# Gemini API Key for Multimodal PDF/Image Document Extraction (Optional - fallback parser used if omitted)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:5001
