# Backend API Environment Variables

# Express Server Port
PORT=5001

# MongoDB Connection URI (Falls back to embedded MongoMemoryServer if unavailable)
MONGODB_URI=mongodb://127.0.0.1:27017/three_way_match

# Gemini API Key for PDF and Image Parsing (Optional - offline fallback parser activates when omitted)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=
